# ===========================================================================
# Soil moisture API configuration (optional)
# ===========================================================================
# Copy this file to `soil_moisture.yaml` and fill in your credentials to
# enable automatic soil-moisture fetching from the UKK-KOSEN Cloudflare D1
# API. If this config file is absent, olive-msystem falls back to manual
# entry of sensor readings on the analysis screens.
#
#   api_base_url:  e.g.  https://xxxx.workers.dev
#   api_key:       your X-Sensor-Api-Key (optional)
#   default_kit_id: the kit/sensor-group identifier
#   cache_ttl:     seconds to cache API responses (default 60)

api_base_url: ""
api_key: ""
default_kit_id: "default"
timeout: 10
cache_ttl: 60

# ===========================================================================
# Sensor alerting (optional)
# ===========================================================================
# Detects sensor anomalies (stale data / abnormal moisture / API errors) and
# notifies through the enabled channels.  Reminders escalate while the
# anomaly persists; a recovery notification is sent when it clears.
#
# channels.inapp       deliver to the app's own notification feed (default true)
# channels.webhooks    list of webhook targets.  Each entry:
#   name       display label (used in the send history)
#   url        full webhook URL
#   format     json (default) | discord | line_notify | text
#              (json is auto-upgraded to a Discord embed card when the URL is a
#              discord.com/api/webhooks/ endpoint)
#   token      optional token; for format=line_notify this is the LINE Notify
#              access token (sent as `Authorization: Bearer <token>`)
#   headers    optional extra headers (map)
#   timeout    request timeout in seconds (default 10)
#   template   optional message template: a preset name (default | concise |
#              detailed) or an inline {title, body} dict with {placeholder}s
#              (falls back to alerts.templates.global, then built-in).
#   example (json, generic):
#     - name: Slack
#       url: https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
#       format: json
#   example (Discord embed card):
#     - name: Discord
#       url: https://discord.com/api/webhooks/XXXX/YYYY
#       format: discord
#   example (LINE Notify):
#     - name: LINE Notify
#       url: https://notify-api.line.me/api/notify
#       format: line_notify
#       token: "YOUR_LINE_NOTIFY_TOKEN"
#   example (plain text, e.g. ntfy):
#     - name: ntfy
#       url: https://ntfy.sh/my-topic
#       format: text
# alerts.templates         message templates:
#   global:                fallback template used when a webhook has none.
#     title: "{title}"
#     body: "..."
#   placeholders: {title} {body} {severity} {mode} {kit_id} {measured_at}
#                 {age_hours} {sensor1} {sensor2} {temperature} {humidity}
#                 {bar1} {bar2} {dry_percent} {wet_percent} {stale_hours}
#                 (+ python format specs like {temperature:.1f})
# alerts.escalation        auto-escalation to critical (hours) per mode:
#   stale: 24              after 24h of a stale alert send one critical notice
#   risk: 12               after 12h of a risk alert send one critical notice
#                          (0 disables escalation for that mode)
# channels.line_bot    LINE BOT (Messaging API) push notification:
#   enabled                  set true to enable
#   channel_access_token     ISSUE page -> Messaging API -> Channel access token
#   to                       the LINE user id that receives the push messages
#   endpoint                 API base (default https://api.line.me/v2/bot/message/push)
#
# Legacy single-webhook shortcut (kept for backward compatibility):
#   channels.webhook_url + channels.webhook_token are migrated into the
#   `webhooks` list automatically when the webhooks list is empty.
alerts:
  enabled: true             # master switch for the monitoring thread
  check_interval_minutes: 10
  stale_hours: 6            # consider the sensor offline after this silence
  dry_percent: 15           # below this -> abnormal dryness alert
  wet_percent: 85           # above this  -> abnormal wetness alert
  notify_risk: true         # also alert on abnormal moisture values (dry/wet)
  remind_hours: [6, 24, 72, 168]   # escalation reminders while an alert is open
  recover_notify: true      # send a "recovered" notification afterwards
  channels:
    inapp: true             # deliver to the app's own notification feed
    webhooks: []            # list of {name, url, format, token, headers, timeout}
    line_bot:
      enabled: false
      channel_access_token: ""
      to: ""
    webhook_url: ""         # legacy: single JSON/webhook URL
    webhook_token: ""       # legacy: LINE Notify token (optional)
